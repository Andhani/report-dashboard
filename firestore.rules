rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email))
        && get(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email)).data.role == "admin";
    }

    // Each signed-in user's report data (URL lists, imported Flow 1/2/3
    // data, settings) lives under their own uid and is invisible to
    // everyone else — no shared documents, no cross-user sync.
    match /users/{uid}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Access allow-list: who may sign in at all, and who is an admin.
    // Any signed-in user may read it (to check their own access), but only
    // an existing admin may write to it.
    match /allowedUsers/{email} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Pending access requests, filed by signed-in people who aren't on the
    // allow-list yet. Deliberately a separate collection: granting access
    // means writing to allowedUsers, which stays admin-only above, so
    // nothing a requester can write here can ever escalate their own
    // privileges. The field whitelist enforces that too — a request cannot
    // carry a "role" at all.
    match /accessRequests/{email} {
      allow create, update: if isSignedIn()
        && request.auth.token.email == email
        && request.resource.data.keys().hasOnly(["email", "name", "requestedAt"])
        && request.resource.data.email == email;

      // Requesters can poll their own request; admins can list them all.
      allow read: if isSignedIn()
        && (request.auth.token.email == email || isAdmin());

      // An admin clears a request on approve/deny; a requester may withdraw
      // their own.
      allow delete: if isSignedIn()
        && (request.auth.token.email == email || isAdmin());
    }
  }
}
