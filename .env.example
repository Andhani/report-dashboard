# Google OAuth2 — powers the "Connect Google account" flow in Settings,
# which the three flows use to read and write the report spreadsheet.
VITE_GOOGLE_CLIENT_ID=your_client_id_here
VITE_GOOGLE_CLIENT_SECRET=your_client_secret_here

# Only set this in a deployed environment. Leave it out locally: the code
# falls back to http://localhost:3000/auth/callback, and pointing it at a
# deployed URL would send the OAuth redirect away from your dev server.
# Whatever value is used here must also be registered as an authorized
# redirect URI on the OAuth client in Google Cloud Console.
VITE_REDIRECT_URI=https://seo-report-dashboard.pages.dev/auth/callback

# Firebase — sign-in gate and per-user report storage. All six are required;
# a missing or wrong value throws at page load and renders a blank page.
# Copy them from Firebase Console > Project settings > Your apps > SDK setup.
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
